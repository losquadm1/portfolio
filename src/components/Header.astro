<div class="header">
    <div class="left">
        <a href="/"><img src="/img/nav/home.webp" alt="" /></a>
    </div>

    <nav aria-label="Primary">
        <ul class="navbar">
            <li class="hideOnMobile"><a href="/ui-ux">UI/UX Design</a></li>
            <li class="separator hideOnMobile" aria-hidden="true">•</li>
            <li class="hideOnMobile"><a href="/graphic-design">Graphic Design</a></li>
            <li class="separator hideOnMobile" aria-hidden="true">•</li>
            <li class="hideOnMobile"><a href="/about">About/Contact</a></li>
            <li class="hideOnDesktop">
                <button type="button" id="menuToggle" aria-label="Open menu">
                    <p>☰</p>
                </button>
            </li>
        </ul>

        
    </nav>
    <div class="navimg" aria-hidden="true">
        <img class="paperrip" src="/img/nav/paperrip.webp" alt="" loading="eager" fetchpriority="high"/>
    </div>
</div>

<div class="space"><br></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('sidebar')
    const toggle = document.getElementById('menuToggle')
    if (!sidebar || !toggle) return

    toggle.addEventListener('click', () => {
      sidebar.classList.add('open')
    })
  })

    document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('sidebar')
    const toggle = document.getElementById('menuToggle')
    const closeBtn = document.getElementById('closeSidebar')
    if (!sidebar || !toggle || !closeBtn) return

    toggle.addEventListener('click', () => {
      sidebar.classList.add('open')
    })

    closeBtn.addEventListener('click', () => {
      sidebar.classList.remove('open')
    })
  })
</script>

<style>

.left, .navbar{
    margin-top: 0px;
}

.space{
    height: 20px;
}
@media (min-width: 2000px) {
    .space{
        height: 40px;
