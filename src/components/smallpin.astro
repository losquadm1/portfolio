---
const {pic, title, link, id, compact = false} = Astro.props;
const rotation = `${(Math.random() * 8 - 4).toFixed(2)}deg`;
---

<a class:list={["smallpin", compact && "smallpin--compact"]} id={id} href={link} style={`--smallpin-rotation: ${rotation};`}>
  <div class="smallpin-card">
    <div class="pin">
      <img src="/img/pin/pin.webp" alt="" />
    </div>
    <img class="pin-image" src={pic} alt="" />
    <p>{title}</p>
    <div class="paper">
      <img class="paper-image" src="/img/pin/photoback.webp" alt="" />
    </div>
  </div>
</a>

<style>
  .smallpin {
    display: block;
    width: 400px;
    aspect-ratio: 3 / 4;
    padding: 24px;
    box-sizing: border-box;
    text-decoration: none;
    color: inherit;
    transform: rotate(var(--smallpin-rotation, 0deg));
    transform-origin: center;
    filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
    
    margin-top: -10px;
  }

  .smallpin-card {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .smallpin:hover {
    filter: brightness(0.7);
  }

  .paper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .paper-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pin {
    position: absolute;
    top: -3%;
    left: 50%;
    transform: translateX(-50%);
    width: 35px;
    z-index: 2;
    filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));

  }

  .pin img {
    width: 100%;
    height: auto;
    display: block;
  }

  .pin-image {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    z-index: 1;
  }

  p {
    position: absolute;
    left: 50%;
    bottom: 7.5%;
    transform: translateX(-50%);
    width: 78%;
    height: 18%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 1;
    font-family: "Covered By Your Grace", cursive;
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    font-weight: 400;
    line-height: 1;
    overflow: hidden;
    text-wrap: balance;
  }

  .smallpin--compact {
    width: 210px;
    height: 280px;
    aspect-ratio: auto;
    padding: 12px;
  }

  .smallpin--compact .pin {
    width: 24px;
  }

  .smallpin--compact p {
    width: 80%;
    font-size: clamp(1rem, 4vw, 1.25rem);
  }

  @media (max-width: 640px) {
    .smallpin {
      width: 210px;
      height: 280px;
      aspect-ratio: auto;
      padding: 12px;
    }

    .pin {
      width: 24px;
    }

    p {
      width: 80%;
      font-size: clamp(1rem, 4vw, 1.25rem);
    }
  }

  @media print {
    .pin,
    .paper,
    .paper-image {
      display: none !important;
    }

    .smallpin {
      filter: none;
      transform: none;
      margin-top: 0;
      padding: 0;
    }
  }
 
</style>