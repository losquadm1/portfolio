---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import Header from "@components/Header.astro"
import HeaderMobile from "@components/HeaderMobile.astro"
import Footer from "@components/Footer.astro"
import SmallPin from "@components/smallpin.astro"
---

<Layout title="Astro Starter">
  <Container>

  <Header/>
  <HeaderMobile/>
  <div class="hero">
    <div class="img">
      <h1>
        <img src="/img/sticker logo.webp" alt="Michael Losquadro" />
        <span class="sticker-caption">portfolio page<span class="sticker-asterisk">*</span></span>
      </h1>
    </div>
  </div>

  <div class="imgds-frame">
    <img class="tape" src="/img/reusable/tape.webp" alt="" />
    <div class="imgds">
      <img src="/img/reusable/rippedpaper.webp" alt="" />
      <h2>Some Personal Favorites:</h2>
    </div>
  </div>

  <div class="favorites">

<SmallPin pic="/img/pin/chet-small.webp" title='"The Chet Show" Thesis Site' link="https://thechetshow.com/" />
<SmallPin pic="/img/pin/chami-small.webp" title='Chami' link="/ui-ux/chami" />
<SmallPin pic="/img/pin/uup-small.webp" title='UUP Website' link="/ui-ux/uup" />

  </div>

  <div class="favorites">

</div>
  </Container>

<Footer/>

</Layout>

<style>
.img{
position: relative;
display: inline-block;
container-type: inline-size;
width: 573px;
padding-top: 35px !important;
padding: 25px;
padding-bottom: 95px !important;
}

.img h1{
  position: relative;
  margin: 0;
}

.img img{
  display: block;
  width: 100%;
  transform: rotate(-2deg);
  filter: drop-shadow(0px 0px 5px rgba(0, 0, 0, 0.15));
  padding: 10px;
background-color: white;
}

.sticker-caption{
  position: absolute;
  right: 8cqi;
  bottom: 11.5cqi;
  transform: rotate(-8deg);
  font-family: "Covered By Your Grace", cursive;
  font-size: clamp(1rem, 5.9cqi, 1.65rem);
  color: #ff4444;
  line-height: 1;
  white-space: nowrap;
  z-index: 2;
}

.sticker-asterisk{
  display: inline-block;
  font-size: 0.7em;
  position: relative;
  top: -0.5em;
}

.imgds-frame{
position: relative;
container-type: inline-size;
max-width:414px;
margin-top: -30px;
box-sizing: border-box;
  padding-left: 5px;
  padding-right: 5px;
}

.imgds{
position: relative;
filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
padding-bottom: 10px;
}

.imgds > img{
  width: 100%;
  height: auto;
  display: block;
}

.tape{
  position: absolute;
  top: -15px;
  left: 50%;
  transform: translateX(-50%);
  height: 42px;
  width: auto;
  z-index: 3;
}

.imgds > h2:first-of-type{
  position: absolute;
  top: 6.5cqi;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: clamp(1.1rem, 8cqi, 2.5rem);
  margin: 0;
  z-index: 2;
}

.favorites{
    display: grid;
    grid-template-columns: auto auto auto;
    align-content: center;
    justify-content: center;
    flex-wrap: wrap;
    text-align: center;
  }

@media (max-width: 1250px){
  .favorites{
  grid-template-columns: auto;
}}

.item img{
  max-width:350px;
  filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
}

.hero{
    display: grid;
    grid-template-columns: auto;
    align-content: center;
    justify-content: center;
    text-align: center;
    justify-items:center;
  }

.item img:hover{
  filter: brightness(0.7)
}
@media (max-width: 590px){
  .img{
    width: 95vw;
    padding: 16px;
    padding-bottom: 72px !important;
  }

  .sticker-caption{
    right: 9cqi;
    bottom: 12cqi;
    font-size: clamp(0.75rem, 6.2cqi, 1.1rem);
  }

  .sticker-asterisk{
    top: -0.35em;
  }

  .img img, .item img{
    max-width: 95vw;
  }
}
</style>