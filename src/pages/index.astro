---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import Header from "@components/Header.astro"
import HeaderMobile from "@components/HeaderMobile.astro"
import Footer from "@components/Footer.astro"
import SmallPin from "@components/smallpin.astro"
---

<Layout title="Astro Starter">
  <Container>

  <Header/>
  <HeaderMobile/>
 <div class="hero">
   <h1>Michael Losquadro</h1>
  <div class="img">
    <img src="/img/sticker logo.webp" alt="Sticky Note Drawing of Michael" />
  </div>
  </div>

  <div class="imgds">
    <h2><img src="/img/personal favorites.svg" alt="Check Out My Personal Favorites:"/></h2>
  </div>

  <div class="favorites">

<SmallPin pic="/img/pin/chet-small.webp" title='"The Chet Show" Thesis Site' link="https://thechetshow.com/" />
<SmallPin pic="/img/pin/chami-small.webp" title='Chami' link="/ui-ux/chami" />
<SmallPin pic="/img/pin/uup-small.webp" title='UUP Website' link="/ui-ux/uup" />

  </div>

  <div class="favorites">

</div>
  </Container>

<Footer/>

</Layout>

<style>
.img{
display: inline;
max-width: 400px;
padding-top: 10px !important;
padding: 25px;
}

.img img{
  transform: rotate(-2deg);
  filter: drop-shadow(0px 0px 5px rgba(0, 0, 0, 0.15));
padding: 10px;
background-color: white;
}

.imgds{
max-width:500px;
margin-top: -30px;
filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
      padding-left: 5px;
      padding-right: 5px;
}

.favorites{
    display: grid;
    grid-template-columns: auto auto auto;
    align-content: center;
    justify-content: center;
    flex-wrap: wrap;
    text-align: center;
  }

@media (max-width: 1050px){
  .favorites{
  grid-template-columns: auto;
}}

.item img{
  max-width:350px;
  filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
}

.hero{
    display: grid;
    grid-template-columns: auto;
    align-content: center;
    justify-content: center;
    text-align: center;
    justify-items:center;
  }

.item img:hover{
  filter: brightness(0.7)
}
@media (max-width: 350px){
  .img img, .item img{
    max-width: 95vw;
  }
}
</style>