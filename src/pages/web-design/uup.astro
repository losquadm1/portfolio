---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import Header from "@components/Header.astro"
import HeaderMobile from "@components/HeaderMobile.astro"
import Footer from "@components/Footer.astro"
import SmallPin from "@components/smallpin.astro"
---

<Layout title="UUP Website">
  <Container>

  <Header/>
    <HeaderMobile/>
  <div class="body">

   <h1>UUP Website</h1>
   <div class="intro">
<p class="intro-built-for">Built for SUNY New Paltz’s Fall 2025 Client Design Course.</p>
<p class="intro-details">
Built for SUNY New Paltz’s Fall 2025 Client Design Course. I was assigned as an Intern for the UUP’s New Paltz branch. In this role I was tasked to rebuild the New Paltz branch’s wordpress site. 
</p><br>
<p class="intro-details">By the end of the project I had completely rebuilt the website from the ground up, bringing it into the modern era of wordpress, as well as updating the site to be usable on mobile devices.</p>
<br><p class="intro-details">Some of my favorite aspects I built into the new site was implementing mail chimp implementation and improving the workflow from google calendar to the website, creating a more self-sufficient website that operates more freely with less direct involvement from moderators.
</p>
    </div>

    <h2><a href="https://uuphost.org/newpaltzwp/">New Paltz UUP Branch Website Link</a></h2>
        <div class="smallpin-wrap">
            <SmallPin pic="/img/pin/uup-small.webp" title='New Paltz UUP Branch' link="https://uuphost.org/newpaltzwp/" />
        </div>

    <h2><a href="/img/pdf/UUP Case Study.pdf">Brand Guidelines(Original)</a></h2>
     <a class="pdf-link" href="/img/pdf/UUP Case Study.pdf"><img class="pdf-preview" src="/img/pdf/UUP.webp" alt="UUP Case Study PDF"></a>

  </div>
  <Footer/>

  </Container>
  </Layout>

  <style>
.intro{
    max-width: 800px;
    padding-bottom: 50px;
}

.intro-built-for{
    margin-top: 0;
    margin-bottom: 18px;
    text-align: center;
}

.intro-details{
    margin-top: 0;
    text-indent: 2em;
}

.smallpin-wrap{
    padding-bottom: 50px;
}

h2{
    text-align: center;
}

h2 a{
    color: black;
    text-decoration-color: var(--color-accent);
    border: 2px solid transparent;
    border-radius: 2px;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease, filter 180ms ease;
}

h1{
    text-align: center;
}

    .iframe{
        width: 200%;
    }

    .body{
        display: flex;
        flex-direction: column; 
        align-items: center;
    }


    .pdf-link{
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .pdf-preview{
            object-fit: contain;
            padding: 10px;
            padding-left: 15px;
            width: 450px;
            margin-left: 0;
            filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
            transition: filter 280ms ease;
        }

        .pdf-preview:hover,
        .pdf-preview:focus-visible{
            filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15)) brightness(0.7);
        }

        .pdf-preview:active,
        .pdf-preview:focus-visible:active{
            filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15)) brightness(0.6);
        }

        @media (min-width: 769px){
            h2 a:hover,
            h2 a:focus-visible{
                border-color: transparent;
                background: #FAF6B1;
                color: #303030;
                text-decoration: none;
                box-shadow: -5px 5px 5px rgba(0, 0, 0, 0.2);
            }

            h2 a:active,
            h2 a:focus-visible:active{
                filter: brightness(0.7);
            }
        }

        @media (max-width: 768px){
            h2 a:hover,
            h2 a:focus-visible{
                color: #303030;
                text-decoration-color: currentColor;
            }

            .body{
                width: 100%;
                padding-left: 10px;
                padding-right: 10px;
                box-sizing: border-box;
            }
        }
  </style>