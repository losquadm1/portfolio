---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import Header from "@components/Header.astro"
import HeaderMobile from "@components/HeaderMobile.astro"
import Footer from "@components/Footer.astro"
import SmallPin from "@components/smallpin.astro"
---

<Layout title="The Chet Show Thesis Site">
  <Container>

  <Header/>
    <HeaderMobile/>
  <div class="body">

   <h1>"The Chet Show" Thesis Site</h1>
   <div class="intro">
<p class="intro-built-for">Built for SUNY New Paltz’s 2026 Thesis course.</p>
<p class="intro-details">
“The Chet Show” was a rounchy college-comedy short film series that I had created alongside my goodfriend Candice Leach. The project was a very fun experience and had a very high production value.</p>
<br><p class="intro-details">For my thesis I decided to document this project through my knowledge of web design. Specifically due to the large scope of the series and how the skills I utilized to manage it all were learnt more from my years of doing design work. In the end <a href="https://thechetshow.com" >thechetshow.com</a> ended up being the largest website I had ever developed up until this point. Utilizing all the content and design skills I had built up until this point, I was able to create a website that acts as a truly memorable user experience.
</p>
    </div>

   <h2>The Chet Show Website Link</h2>
    <SmallPin pic="/img/pin/chet-small.webp" title='"The Chet Show" Thesis Site' link="https://thechetshow.com" />

    <h2>Brand Guidelines(Original)</h2>
     <a class="pdf-link" href="/img/pdf/Chet Process Book.pdf"><img class="pdf-preview" src="/img/pdf/Chet.webp" alt="Chet Thesis Process Book PDF"></a>

  </div>
  <Footer/>

  </Container>
  </Layout>

  <style>
.intro{
    max-width: 800px
}

.intro-built-for{
    margin-top: 0;
    margin-bottom: 18px;
    text-align: center;
}

.intro-details{
    margin-top: 0;
    text-indent: 2em;
}

    .iframe{
        width: 200%;
    }

    .body{
        display: flex;
        flex-direction: column; 
        align-items: center;
    }


    .pdf-link{
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .pdf-preview{
            object-fit: contain;
            padding: 10px;
            padding-left: 15px;
            max-width: 450px;
            margin-left: 0;
            filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15));
            transition: filter 280ms ease;
        }

        .pdf-preview:hover,
        .pdf-preview:focus-visible{
            filter: drop-shadow(-10px 10px 5px rgba(0, 0, 0, 0.15)) brightness(0.7);
        }
  </style>