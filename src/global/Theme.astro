---
// we can import fonts here, after installing them via Fontsource
// see https://fontsource.org/docs/installation for instructions
---

<style is:global>
  /* We can use this style tag to set up colors, fonts, etc. */
/* caladea */
  @import url('https://fonts.googleapis.com/css2?family=Caladea:ital,wght@0,400;0,700;1,400;1,700&display=swap');
/* covered by your grace */
@import url('https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&display=swap');

  :root {
    --color-background: #d1d1b1;
    --color-text: black;
    --color-accent: #c32101;
    --color-focus-ring: #c32101;

    --font-body: "Caladea", sans-serif;
    --font-headings: "Caladea", sans-serif;

    font-size: 20px;

    /* These sizes are used by the Container component to set up the page container */
    --size-page-width: 800px;
    --size-page-padding: 1rem;
  }

  /* We can also apply these colors as a default */
  body {
    background-image: linear-gradient(
        rgba(235, 235, 209, 0.5),
        rgba(235, 235, 209, 0.5)
      ),
      url("/img/Whitewall.png");
    background-size: auto, 1024px auto;
    background-position: top left;
    background-repeat: repeat;
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: normal;
    color: var(--color-text);
  }

h1{
    font-size:70px

  }
h2{
  font-size:45px
} 

h3{
  font-size:30px
}

  /* default focus ring styles */
  *:focus-visible {
    outline: 3px solid var(--color-focus-ring);
  }

a{
  color: var(--color-accent);
}
a:visited{
  color: var(--color-accent);
}
p a{
  border: 2px solid transparent;
  border-radius: 2px;
  transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease, filter 180ms ease;
}

p a:hover,
p a:focus-visible{
  border-color: transparent;
  background: #FAF6B1;
  color: #303030;
  box-shadow: -5px 5px 5px rgba(0, 0, 0, 0.2);
}

p a:active,
p a:focus-visible:active{
  filter: brightness(0.7);
}

  .external-leave-overlay{
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    padding: 20px;
    overflow: hidden;
  }

  .external-leave-overlay.open{
    display: flex;
  }

  .external-leave-overlay::before,
  .external-leave-overlay::after{
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .external-leave-overlay::before{
    background-image: url('/img/nav/crumpled.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.4;
    z-index: 0;
  }

  .external-leave-overlay::after{
    background-image: linear-gradient(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.15)), linear-gradient(rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.15));
    z-index: 0;
  }

  .external-leave-dialog{
    position: relative;
    z-index: 1;
    width: min(760px, calc(100vw - 40px));
    background: #FAF6B1;
    color: #111111;
    box-shadow: -10px 10px 5px rgba(0, 0, 0, 0.15);
    padding: clamp(14px, 2.2vw, 24px);
    text-align: center;
  }

  .external-leave-text{
    margin: 0;
    font-size: clamp(1rem, 1.9vw, 1.35rem);
    line-height: 1.3;
  }

  .external-leave-actions{
    margin-top: 14px;
    display: flex;
    gap: 18px;
    justify-content: center;
  }

  .external-leave-button{
    border: 2px solid #111111;
    border-radius: 2px;
    background: #FAF6B1;
    color: #111111;
    width: clamp(56px, 8vw, 68px);
    height: clamp(56px, 8vw, 68px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-family: "Covered By Your Grace", cursive;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .external-leave-button:hover{
    background: #efe68f;
  }

  .external-leave-button:active{
    background: #e2d86d;
  }

  @media (max-width: 768px){
h1{
    font-size:40px;
    font-weight: 700;
  }
h2{
  font-size:34px;
  font-weight: 700;
} 

h3{
  font-size:30px;
  font-weight: 700;
}
  }


</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.createElement("div");
    overlay.className = "external-leave-overlay";
    overlay.setAttribute("aria-hidden", "true");

    overlay.innerHTML = `
      <div class="external-leave-dialog" role="dialog" aria-modal="true" aria-label="Leaving site confirmation">
        <p class="external-leave-text">You are about to leave michaellosquadro.com.<br>Are you sure you want to continue?</p>
        <div class="external-leave-actions">
          <button type="button" class="external-leave-button" data-action="ok">Yes</button>
          <button type="button" class="external-leave-button" data-action="stay">No</button>
        </div>
      </div>
    `;

    document.body.appendChild(overlay);

    const stayButton = overlay.querySelector<HTMLButtonElement>('[data-action="stay"]');
    const okButton = overlay.querySelector<HTMLButtonElement>('[data-action="ok"]');
    let pendingHref = "";
    let pendingTarget = "";

    const closeOverlay = () => {
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      pendingHref = "";
      pendingTarget = "";
    };

    const openOverlay = (href = "", target = "") => {
      pendingHref = href;
      pendingTarget = target;
      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
    };

    stayButton?.addEventListener("click", closeOverlay);

    okButton?.addEventListener("click", () => {
      if (!pendingHref) {
        closeOverlay();
        return;
      }

      const href = pendingHref;
      const target = pendingTarget;
      closeOverlay();

      if (target === "_blank") {
        window.open(href, "_blank", "noopener,noreferrer");
      } else {
        window.location.href = href;
      }
    });

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) {
        // Simulate clicking the No button for full accessibility parity
        stayButton?.click();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && overlay.classList.contains("open")) {
        closeOverlay();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }

      const link = target.closest("a[href]");
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const href = link.getAttribute("href") || "";
      if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) {
        return;
      }

      let url;
      try {
        url = new URL(link.href, window.location.href);
      } catch {
        return;
      }

      const isExternal = url.origin !== window.location.origin;
      if (!isExternal) {
        return;
      }

      event.preventDefault();
      openOverlay(link.href, link.getAttribute("target") || "");
    });
  });
</script>
